{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020", "dom"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": "./",
    "paths": {
      "@core/*": ["core/*"],
      "@adapters/*": ["adapters/*"],
      "@infrastructure/*": ["infrastructure/*"]
    }
  },
  "include": [
    "core/**/*",
    "adapters/**/*",
    "examples/**/*",
    "infrastructure/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
